RUTA_RAIZ = './data/'
RUTA_ID = RUTA_RAIZ + 'PNT MDR/ERP/I+D/'

def generar_resumenes_por_articulo(directorio_base):
    """
    Recorre las carpetas de artículos, lee todos los Excels de órdenes
    de producción dentro de cada una y genera un Excel resumen.
    """
    # Verificamos que el directorio base existe
    if not os.path.exists(directorio_base):
        print(f"Error: La carpeta '{directorio_base}' no existe.")
        return 

    # Listamos solo las carpetas dentro del directorio base (cada carpeta es un artículo)
    carpetas_articulos = [c for c in os.listdir(directorio_base) 
                          if os.path.isdir(os.path.join(directorio_base, c))]
    
    print(f"Se encontraron {len(carpetas_articulos)} carpetas de artículos.")
    carpetas_articulos = ['PHB1V01_TEST'] # TODO Borrar esta línea para procesar todas las carpetas, está solo para pruebas rápidas
    
    # Iteramos sobre cada carpeta de artículo
    for articulo in carpetas_articulos:
        print(f"Procesando artículo: {articulo}...")
        ruta_articulo = os.path.join(directorio_base, articulo)

        # Busca el excel resumen ( se considerra que es el resumen si contiene la palabra resumen en su nombre)
        
        directorios_articulo = os.listdir(ruta_articulo)
        
        for archivo in directorios_articulo:
                if "resumen" in archivo.lower() and archivo.endswith((".xlsx", ".xls")):
                    ruta_resumen = os.path.join(ruta_articulo, archivo)
                    print( "Procesando", ruta_resumen)
                    break  
        else:
            print(f"  -> No se encontró un resumen existente para '{articulo}'. CREALO A MANO.")
            time.sleep(3) # Pausa de 2 segundos para que el usuario pueda leer el mensaje
            break # Dejamos de procesar ek artuculo si no tiene resuemn

        try:
            df_resumen = pd.read_excel(ruta_resumen, header=3)
            # Preprocesamos el dataframe

        except Exception as e:
            print(f"  -> Aviso: No se pudo leer el resumen existente: {e}")
        
        else:
            
            ordenes = [x.strip() for x in [os.path.splitext(f)[0] for f in [f for f in directorios_articulo if not f.lower().endswith(".pdf") and "resumen" not in f.lower()]]] # Ordenes en la carpeta (procesadas o no)
            ordenes_procesadas = df_resumen["ORDEN DE PRODUCCION"].dropna().drop_duplicates().tolist()
            invalidos = [x for x in ordenes_procesadas if not re.match(r"^\d{3} \d{2}_\d{2}_\d{2}$", x)] # Validamos el formato de las ordenes procesadas, si no cumplen el formato se consideran invalidas
            if invalidos: # Si hay ordenes invalidas, las mostramos al usuario para que las corrija manualmente en el excel resumen
                print(f"El excel resumen de {articulo} tiene los siguientes códigos inválidos en las ordenes de producción: {invalidos}")
                time.sleep(3) # Pausa de 3 segundos para que el usuario pueda leer el mensaje
            print(f"  -> Total de órdenes en la carpeta: {(ordenes)}")
            time.sleep(3)

if __name__ == "__main__":

    CARPETA_PRINCIPAL = RUTA_ID
    generar_resumenes_por_articulo(CARPETA_PRINCIPAL)